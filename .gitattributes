# Default to LF for all text in the repo, regardless of platform.
* text=auto eol=lf

# Explicitly mark Python and config files as text.
*.py     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
*.txt    text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf

# Binaries — never normalise.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
